{
  "version": 2,
  "buildCommand": "",
  "outputDirectory": "public",
  "functions": {
    "api/leads.js": {
      "maxDuration": 10,
      "includeFiles": "api/apollo-leads.json"
    },
    "api/cron/fetch-leads.js": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/cron/fetch-leads",
      "schedule": "0 0 * * *"
    }
  ]
}
